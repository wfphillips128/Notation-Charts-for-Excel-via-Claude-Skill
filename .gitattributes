# Normalise line endings: store LF in the repo, check out the platform's native
# ending. Without this, Windows contributors produce diffs that touch every line
# of a file they only changed one line in.
* text=auto

# VBA modules are imported into Excel on Windows, which expects CRLF.
*.bas text eol=crlf

# Binary by nature. `text=auto` above already detects these by sniffing for NUL
# bytes, so this fixes nothing today - it says the intent out loud, so a future
# rule written for text can never catch them, and it keeps `git diff` quiet.
*.xlsx binary
*.png  binary
*.zip  binary
